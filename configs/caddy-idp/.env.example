# Image tags (same pins as configs/localhost).
# PrivacyFence image. It floats on purpose; to hold back an update pin an exact version such as 7.0.0.
PRIVACYFENCE_IMAGE_TAG=latest
# Peek image.
PEEK_IMAGE_TAG=0.18.0
# Grist image from PrivacyFence's grist-core fork (open-source build).
GRIST_IMAGE_TAG=1.7.22-pf.4
# grist-provisioner image.
GRIST_PROVISIONER_IMAGE_TAG=0.2.0
# Alpine image for the one-shot init service (a minor series is enough for a busybox script).
ALPINE_IMAGE_TAG=3.22
# Caddy image.
CADDY_IMAGE_TAG=2.10.2

# Public host name of PrivacyFence (DNS must point at this server).
PF_HOSTNAME=
# Public host name of Peek.
PEEK_HOSTNAME=
# Public host name of Grist (the Grist provisioner shares it).
GRIST_HOSTNAME=
# PrivacyFence admins: comma-separated email addresses, each in ALLOWED_DOMAIN.
ADMIN_EMAILS=
# The one domain whose people may sign in to all three apps (exactly one domain; PrivacyFence reads it only at its first start, later changes go through its Admin page).
ALLOWED_DOMAIN=
# Grist install admin: a real address in the organization that can sign in to PrivacyFence (a dedicated admin address is recommended).
# Its automatic Grist key is refused; that person connects Grist by hand on PrivacyFence's /connect.
GRIST_ADMIN_EMAIL=
# Peek admins (optional): comma-separated addresses in ALLOWED_DOMAIN; they connect Peek by hand on /connect, because Peek refuses to provision admins.
PEEK_ADMIN_EMAILS=
# Grist team site name (optional).
GRIST_TEAM_SITE=team

# OIDC issuer URL of your identity provider.
IDP_ISSUER=
# Client ID of the confidential OIDC client you registered for PrivacyFence.
IDP_CLIENT_ID=
# The client secret goes in secrets/idp_client_secret, never in this file.
# Register ONE confidential client with these three redirect URIs:
#   https://<PF_HOSTNAME>/oauth/idp/callback
#   https://<PF_HOSTNAME>/oauth/idp/login-callback
#   https://<PF_HOSTNAME>/oauth/stepup/callback
# Peek and Grist refuse a sign-in unless email_verified is true, and PrivacyFence passes on what the
# identity provider says. Some providers never send the claim (Microsoft Entra ID among them). For
# those, set this to true: PrivacyFence then treats addresses in ALLOWED_DOMAIN as verified.
# IDP_TRUST_UNVERIFIED_EMAIL=true
