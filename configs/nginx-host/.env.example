# Image tags (same pins as configs/localhost).
# PrivacyFence image. It floats on purpose; to hold back an update pin an exact version such as 7.0.0.
PRIVACYFENCE_IMAGE_TAG=latest
# Peek image.
PEEK_IMAGE_TAG=0.18.1
# Grist image from PrivacyFence's grist-core fork (open-source build).
GRIST_IMAGE_TAG=1.7.22-pf.4
# grist-provisioner image.
GRIST_PROVISIONER_IMAGE_TAG=0.2.0
# Alpine image for the one-shot init service (a minor series is enough for a busybox script).
ALPINE_IMAGE_TAG=3.22

# Public host names, as the host's nginx serves them (DNS must point at this server).
PF_HOSTNAME=
# Peek's one base URL (its sign-in callback is built from it); redirect any other Peek name to it in nginx.
PEEK_HOSTNAME=
# Grist's host name (the Grist provisioner shares it).
GRIST_HOSTNAME=
# The one domain whose people may sign in to all three apps (exactly one domain; PrivacyFence reads it only at its first start, later changes go through its Admin page).
ALLOWED_DOMAIN=
# Grist install admin: an address in the organization that owns the team site. The provisioner never gives it an automatic Grist key.
GRIST_ADMIN_EMAIL=
# Peek admins (optional): comma-separated addresses in ALLOWED_DOMAIN; they connect Peek by hand on /connect, because Peek refuses to provision admins.
PEEK_ADMIN_EMAILS=
# Grist team site name (optional).
GRIST_TEAM_SITE=team
# Other names that should redirect to PEEK_HOSTNAME, space-separated (optional); nginx/render.sh writes a server for each.
PEEK_REDIRECT_HOSTNAMES=
# Name of PrivacyFence's provisioning key in Peek (optional). A key with this name is rotated in place, otherwise a new one is registered.
PEEK_PROVISIONING_KEY_NAME=PrivacyFence

# PrivacyFence's identity provider and admins go in privacyfence.env (see privacyfence.env.example).
# An existing stack under another Compose project name keeps it (and its volumes) with, for example:
# COMPOSE_PROJECT_NAME=privacyfence-host

# Optional: Peek page backends (docs/configurations.md#peek-page-backends). To turn them on,
# uncomment COMPOSE_FILE and set DOCKER_GID to the group of the Docker socket
# (stat -c %g /var/run/docker.sock). This gives Peek the Docker socket, which is root on the host.
# COMPOSE_FILE=compose.yaml:compose.backends.yaml
DOCKER_GID=
