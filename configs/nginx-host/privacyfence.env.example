# PrivacyFence's sign-in settings. Copy to privacyfence.env (mode 0600) and keep one of the blocks below.
# compose.yaml sets PRIVACYFENCE_BIND_HOST, _PORT, _ISSUER_URL, _TRUSTED_PROXIES, _ALLOWED_DOMAINS and the
# Peek, Grist and OIDC-client variables itself, and those win over this file. Never put a provisioning
# key here: init generates them.

PRIVACYFENCE_MODE=org

# Your own OIDC identity provider. Register one confidential client with the redirect URIs
# https://<PF_HOSTNAME>/oauth/idp/callback, /oauth/idp/login-callback and /oauth/stepup/callback.
# The client secret goes in secrets/idp_client_secret; init installs it at this path:
# PRIVACYFENCE_IDP_ISSUER=
# PRIVACYFENCE_IDP_CLIENT_ID=
# PRIVACYFENCE_IDP_CLIENT_SECRET_FILE=/run/suite/idp_client_secret
# PRIVACYFENCE_ADMIN_EMAILS=
# Microsoft Entra ID sends no email_verified claim; then also:
# PRIVACYFENCE_IDP_TRUST_UNVERIFIED_EMAIL=true
# Your own Google OAuth app is the same block with PRIVACYFENCE_IDP_ISSUER=https://accounts.google.com.

# Or PrivacyFence's built-in Google sign-in (nothing to register; publish the relay DNS records once):
# PRIVACYFENCE_IDP=builtin-google
# PRIVACYFENCE_ADMIN_EMAILS=
