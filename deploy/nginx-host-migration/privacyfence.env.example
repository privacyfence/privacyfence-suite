# PrivacyFence's server settings. Copy to privacyfence.env (mode 0600) and fill in from step 1 of
# README.md: the lines `privacyfence-app --print-env-from-bundle` printed on the pip install, which are
# also in /etc/privacyfence-org.env once the bundle is retired.
#
# compose.yaml sets PRIVACYFENCE_BIND_HOST, _PORT, _ISSUER_URL, _TRUSTED_PROXIES and the Peek, Grist
# and OIDC-client variables itself, and those win over this file. Leave out the old Peek/Grist
# provisioning key lines: the stack generates new keys.

PRIVACYFENCE_MODE=org
PRIVACYFENCE_ADMIN_EMAILS=

# Your own identity provider (as printed). The client secret file is installed by `init` from
# secrets/idp_client_secret, so the path in the container is always this one:
# PRIVACYFENCE_IDP_ISSUER=
# PRIVACYFENCE_IDP_CLIENT_ID=
# PRIVACYFENCE_IDP_CLIENT_SECRET_FILE=/run/suite/idp_client_secret
# Microsoft Entra ID sends no email_verified claim; 7.x then needs:
# PRIVACYFENCE_IDP_TRUST_UNVERIFIED_EMAIL=true

# Or PrivacyFence's built-in Google sign-in:
# PRIVACYFENCE_IDP=builtin-google
