# Image tags.
# PrivacyFence: the exact version the pip install runs after README.md step 1 (7.0.0 or later), so the
# data moves to the same version. Float on `latest` later if you want.
PRIVACYFENCE_IMAGE_TAG=7.0.0
# Peek. 0.18.0 is the first version that takes its sign-in and provisioning key from the environment.
PEEK_IMAGE_TAG=0.18.0
# Grist from PrivacyFence's grist-core fork. The old Grist must not be newer (migrate.sh preflight).
GRIST_IMAGE_TAG=1.7.22-pf.4
# grist-provisioner (new: it gives each person their Grist user and key).
GRIST_PROVISIONER_IMAGE_TAG=0.2.0
# Alpine for the one-shot init service.
ALPINE_IMAGE_TAG=3.22

# Public host names, as the host's nginx serves them today.
PF_HOSTNAME=
# Peek's one base URL (its sign-in callback is built from it). Use the name PrivacyFence 6.11 already
# connects Peek with; redirect any other Peek name to it in nginx.
PEEK_HOSTNAME=
GRIST_HOSTNAME=

# The one email domain whose people may use Peek and get a Grist user.
ALLOWED_DOMAIN=
# The Grist team site that holds the existing documents (its domain, as migrate.sh preflight lists it).
GRIST_TEAM_SITE=
# Grist install admin: a real address that can sign in to PrivacyFence and owns GRIST_TEAM_SITE.
GRIST_ADMIN_EMAIL=
# Peek admins (optional): comma-separated, in ALLOWED_DOMAIN. Existing Peek admins stay admins.
PEEK_ADMIN_EMAILS=
# The name of the provisioning key PrivacyFence uses in Peek (Peek Admin page, provisioning keys).
# Keep PrivacyFence when Peek has none: a new key is registered under that name.
PEEK_PROVISIONING_KEY_NAME=PrivacyFence

# Used only by migrate.sh, not by compose.
# The pip install's data directory and the old containers.
OLD_PF_DATA=/var/lib/privacyfence-org/.privacyfence
OLD_PF_UNIT=privacyfence-org
OLD_PEEK_CONTAINER=peek
OLD_GRIST_CONTAINER=grist
# The htpasswd file nginx used for Grist (optional: preflight compares its names with Grist's users).
OLD_GRIST_HTPASSWD=
# Other names nginx serves for these apps today, space-separated (a second Peek name, for example);
# migrate.sh nginx-files lists their files too.
OLD_EXTRA_HOSTNAMES=
