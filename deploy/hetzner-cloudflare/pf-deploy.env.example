# Copy to /root/pf-deploy.env (chmod 600) on the server, fill in, then run: sudo ./bootstrap.sh all
PF_HOSTNAME=pf.tkcs.name
PEEK_HOSTNAME=peek.tkcs.name
GRIST_HOSTNAME=grist.tkcs.name

# Must be a Google Workspace domain (built-in Google sign-in admits only verified Workspace accounts).
ALLOWED_DOMAIN=
# Comma-separated, each in ALLOWED_DOMAIN.
ADMIN_EMAILS=
# A real, separate address in ALLOWED_DOMAIN that can sign in to PrivacyFence.
GRIST_ADMIN_EMAIL=
PEEK_ADMIN_EMAILS=

# Tailscale auth key (reusable=no, ephemeral=no, tagged e.g. tag:server): https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_HOSTNAME=pf-suite

# Cloudflare API token with Zone:DNS:Edit on the zone (only used by certbot for the DNS-01 challenge).
CF_API_TOKEN=
# Let's Encrypt account email.
LE_EMAIL=

# Optional: pin a suite release (e.g. 0.1.0). Empty = latest.
SUITE_VERSION=
